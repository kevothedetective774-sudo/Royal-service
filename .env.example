# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: Neon PostgreSQL connection string (ep-little-hall-b5o6vcsm)
# Configure this in the AI Studio Settings -> Secrets panel:
DATABASE_URL="postgresql://neondb_owner:npg_TXm6UtSlW7Ae@ep-little-hall-b5o6vcsm-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# PAYHERO API CONFIGURATION
# Direct Basic Auth Token from your PayHero Dashboard:
PAYHERO_AUTH_TOKEN=

# PAYHERO_CHANNEL_ID: Your PayHero registered Paybill or Till channel ID
PAYHERO_CHANNEL_ID=

# PAYHERO_PROVIDER: Default 'm-pesa'
PAYHERO_PROVIDER="m-pesa"

# PAYHERO_CALLBACK_URL: (Optional) Automatically dynamic per request. Provide only to enforce a static custom URL.
PAYHERO_CALLBACK_URL=

# NOWPAYMENTS API CONFIGURATION (USDT ON POLYGON - usdtmatic)
# From your NOWPayments Dashboard (account.nowpayments.io):
# 1. Store Settings -> API Keys -> Generate API Key
# 2. Store Settings -> Instant Payment Notification (IPN) Secret Key
# 3. Account Email & Password (used by automated Payouts API /v1/auth to disburse withdrawals directly to Polygon wallets)
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_EMAIL=
NOWPAYMENTS_PASSWORD=
NOWPAYMENTS_CURRENCY="usdtmatic"


